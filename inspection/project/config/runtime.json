{
  "_说明": "CATIA 检查系统 v1.1 运行配置示例。生产环境应复制后填写公司内网地址，不要在此文件中写入密钥。",
  "schema_version": "1.1.0",
  "execution": {
    "_说明": "确定性检查始终在本机运行，AI 失败不得阻断检查。",
    "offline_core_required": true,
    "save_source_model": false,
    "full_product_clash_mode": "BETWEEN_ALL",
    "clearance_mm": 0.1,
    "max_conflicts": 10000
  },
  "llm": {
    "_说明": "模板模式；接入模型时仅使用经批准的服务及环境变量密钥。",
    "mode": "template",
    "base_url": "",
    "model": "",
    "timeout_seconds": 60,
    "api_key_env": "CATIA_CHECKER_LLM_API_KEY",
    "extra_headers": {},
    "_安全说明": "密钥只从环境变量读取；模型、截图、完整装配树和坐标默认不得传出公司内网。"
  },
  "fallback": {
    "_说明": "内网大模型不可用时自动使用模板报告。",
    "enabled": true,
    "mode": "template"
  },
  "audit": {
    "_说明": "记录模型、规则、提示词、知识库和大模型版本，便于追溯。",
    "enabled": true,
    "redact_component_names": false,
    "log_prompt_body": false
  },
  "deployment": {
    "os": "Windows",
    "architecture": "x64",
    "catia_target": "CATIA V5 R30;现场待验收",
    "integration": "standard_mcp"
  }
}